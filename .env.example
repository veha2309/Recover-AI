OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:latest
# Only rzp_test_ keys are accepted. Leave blank for deterministic simulation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=recoverai-local-webhook-secret-change-me
RECOVERAI_DB=./data/recoverai.sqlite

# Server-only Gemini credentials. Never use NEXT_PUBLIC_ for keys.
AI_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Required for production start; login username is demo.
DEMO_PASSWORD=

